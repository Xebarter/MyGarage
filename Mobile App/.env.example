# MyGarage web API — only needed for production builds.
# In dev, the app auto-detects your LAN IP from the Expo dev server.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Public site URL used for Paytota payment return callbacks (must match NEXT_PUBLIC_APP_URL on the server).
EXPO_PUBLIC_APP_URL=https://mygarage.ug

# Optional override for Google OAuth redirect (defaults to EXPO_PUBLIC_APP_URL/auth/mobile-callback).
# Add the same URL to Supabase → Authentication → URL Configuration → Redirect URLs.
# EXPO_PUBLIC_AUTH_REDIRECT_URI=https://mygarage.ug/auth/mobile-callback

# Same Supabase project as the Next.js app (from .env in repo root)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Address autocomplete uses Google Places on the Next.js server.
# Add GOOGLE_MAPS_API_KEY to the repo root .env (Places API + Places API (New) enabled).

# Required for map tiles on Android (and recommended for iOS). Can be the same key as the server.
# Enable "Maps SDK for Android" and "Maps SDK for iOS" in Google Cloud, then restart Expo.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
