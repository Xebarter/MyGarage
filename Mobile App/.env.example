# MyGarage buyer app — Flutter
#
# The app loads assets/app.env (see pubspec assets). Copy these values into assets/app.env
# after editing. Root .env is optional / gitignored for local notes.
#
# Production API (use www — apex redirects break some mobile verbs):
API_URL=https://www.mygarage.ug
#
# Local Next.js:
#   Flutter web / desktop → http://localhost:3000
#   Android emulator      → http://10.0.2.2:3000
#   Physical device       → http://YOUR_PC_LAN_IP:3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_MAPS_API_KEY=

AUTH_DEEP_LINK_URI=mygarage://login-callback
# AUTH_REDIRECT_URI=https://www.mygarage.ug/auth/mobile-callback
