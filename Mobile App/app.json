{
  "expo": {
    "name": "MyGarage",
    "slug": "mygarage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mygarage",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ug.mygarage.app"
    },
    "android": {
      "package": "ug.mygarage.app",
      "adaptiveIcon": {
        "backgroundColor": "#3B82F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-black.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 240
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MyGarage to use your location so service providers can find you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MyGarage to access your photos so you can add vehicle pictures.",
          "cameraPermission": "Allow MyGarage to use your camera to take vehicle photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "",
      "EXPO_PUBLIC_SUPABASE_URL": "",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": ""
    }
  }
}
