# MyGarage web API origin (Next.js).
# Android emulator → host machine: http://10.0.2.2:3000
# Physical device → your LAN IP, e.g. http://192.168.1.20:3000
# Production: https://mygarage.ug
API_URL=http://10.0.2.2:3000

# Same Supabase project as the Next.js app / buyer Mobile App
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Maps SDK (enable Maps SDK for Android + iOS)
GOOGLE_MAPS_API_KEY=

# Google OAuth (native): HTTPS page Supabase redirects to, then opens the app deep link.
# Must be listed in Supabase → Authentication → Redirect URLs.
# Default: {API_URL}/auth/services-mobile-callback
# AUTH_REDIRECT_URI=https://mygarage.ug/auth/services-mobile-callback

# Custom scheme opened by the bridge page (must match Android/iOS intent filters)
# AUTH_DEEP_LINK_URI=ug.mygarage.services://login-callback
