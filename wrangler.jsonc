{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mygarage",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // Keep variables already set on the Worker. This file does not list them.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match "name". The package name is my-project; the Worker is mygarage.
      "service": "mygarage"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false
    }
  }
}
