# Production uses the www host (apex redirects break POST from mobile):
# API_URL=https://www.mygarage.ug
API_URL=http://10.0.2.2:3000

# Same Supabase project as the Next.js app
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google OAuth (native): HTTPS page Supabase redirects to, then opens the app deep link.
# Must be listed in Supabase → Authentication → Redirect URLs.
# Default: {API_URL}/auth/supplier-mobile-callback
# AUTH_REDIRECT_URI=https://www.mygarage.ug/auth/supplier-mobile-callback

# Custom scheme opened by the bridge page (must match Android/iOS intent filters)
# AUTH_DEEP_LINK_URI=ug.mygarage.supplier://login-callback
